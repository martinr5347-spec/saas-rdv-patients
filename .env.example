# Unipile (WhatsApp)
UNIPILE_API_KEY=
UNIPILE_BASE_URL=

# MercadoPago (test uniquement — tokens prod stockés par tenant dans org_settings)
MP_ACCESS_TOKEN_TEST=
WEBHOOK_SECRET_MERCADOPAGO=

# Chiffrement des secrets sensibles stockés en base (ex. org_settings.mp_access_token) —
# générer avec : openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=
WEBHOOK_SECRET_CALENDLY=
CRON_SECRET=

# NaveoFlow (script tiers pour enregistrer des guides interactifs) — desactive par defaut.
# Ne jamais laisser actif en continu (pages /dashboard = donnees patients) : activer sur Vercel
# uniquement le temps d'enregistrer un guide, puis redesactiver juste apres.
NEXT_PUBLIC_NAVEOFLOW_ENABLED=false
